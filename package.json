{
    "name": "plugim",
    "private": true,
    "packageManager": "pnpm@12.14.0",
    "scripts": {
        "dev:server": "cargo run --manifest-path apps/server/Cargo.toml",
        "dev:web": "pnpm --filter @plugim/web dev",
        "typecheck": "pnpm --filter @plugim/web typecheck && pnpm check:server",
        "check:server": "cargo check --manifest-path apps/server/Cargo.toml",
        "test": "pnpm -r test",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "fmt:server": "cargo fmt --manifest-path apps/server/Cargo.toml",
        "build": "pnpm --filter @plugim/web build && cargo build --release --manifest-path apps/server/Cargo.toml",
        "start": "apps/server/target/release/plugim-server",
        "smoke": "bash scripts/smoke.sh",
        "smoke:pg": "bash scripts/smoke-pg.sh",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.12",
        "vitepress": "^1.6.4"
    }
}
