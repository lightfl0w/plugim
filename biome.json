{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
        "includes": ["**", "!**/dist", "!**/data", "!**/*.css"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "css": {
        "formatter": {
            "enabled": false
        },
        "linter": {
            "enabled": false
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["**/src/components/ui/**"],
            "linter": {
                "rules": {
                    "a11y": {
                        "noLabelWithoutControl": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/src/plugins/ui-composer.tsx"],
            "linter": {
                "rules": {
                    "a11y": {
                        "noStaticElementInteractions": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/src/plugins/ui-org-page.tsx"],
            "linter": {
                "rules": {
                    "a11y": {
                        "noStaticElementInteractions": "off",
                        "useKeyWithClickEvents": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/src/plugins/ui-admin-page.tsx"],
            "linter": {
                "rules": {
                    "a11y": {
                        "noStaticElementInteractions": "off",
                        "useKeyWithClickEvents": "off"
                    }
                }
            }
        }
    ]
}
